<* if {{ is_dark_mode }} *>
# Dark scheme: muted source-color for normal, bright primary for bright.
background={{ colors.surface.default.hex | replace: "#", "" }}
foreground={{ colors.on_surface.default.hex | replace: "#", "" }}
regular0={{ colors.outline.default.hex | replace: "#", "" }}
regular1={{ colors.source_color.default.hex | set_hue: 5.0 | replace: "#", "" }}
regular2={{ colors.source_color.default.hex | set_hue: 120.0 | replace: "#", "" }}
regular3={{ colors.source_color.default.hex | set_hue: 50.0 | replace: "#", "" }}
regular4={{ colors.source_color.default.hex | replace: "#", "" }}
regular5={{ colors.source_color.default.hex | set_hue: 300.0 | replace: "#", "" }}
regular6={{ colors.source_color.default.hex | set_hue: 190.0 | replace: "#", "" }}
regular7={{ colors.on_surface.default.hex | replace: "#", "" }}
bright0={{ colors.outline.default.hex | replace: "#", "" }}
bright1={{ colors.primary.default.hex | set_hue: 5.0 | replace: "#", "" }}
bright2={{ colors.primary.default.hex | set_hue: 120.0 | replace: "#", "" }}
bright3={{ colors.primary.default.hex | set_hue: 50.0 | replace: "#", "" }}
bright4={{ colors.primary.default.hex | replace: "#", "" }}
bright5={{ colors.primary.default.hex | set_hue: 300.0 | replace: "#", "" }}
bright6={{ colors.primary.default.hex | set_hue: 190.0 | replace: "#", "" }}
bright7={{ colors.on_surface.default.hex | replace: "#", "" }}
selection-foreground={{ colors.on_primary.default.hex | replace: "#", "" }}
selection-background={{ colors.primary.default.hex | replace: "#", "" }}
<* else *>
# Light scheme: dark primary for normal, vivid source-color for bright.
background={{ colors.surface.default.hex | replace: "#", "" }}
foreground={{ colors.on_surface.default.hex | replace: "#", "" }}
regular0={{ colors.outline.default.hex | replace: "#", "" }}
regular1={{ colors.primary.default.hex | set_hue: 5.0 | replace: "#", "" }}
regular2={{ colors.primary.default.hex | set_hue: 120.0 | replace: "#", "" }}
regular3={{ colors.primary.default.hex | set_hue: 50.0 | replace: "#", "" }}
regular4={{ colors.primary.default.hex | replace: "#", "" }}
regular5={{ colors.primary.default.hex | set_hue: 300.0 | replace: "#", "" }}
regular6={{ colors.primary.default.hex | set_hue: 190.0 | replace: "#", "" }}
regular7={{ colors.on_surface.default.hex | replace: "#", "" }}
bright0={{ colors.outline.default.hex | replace: "#", "" }}
bright1={{ colors.source_color.default.hex | set_hue: 5.0 | replace: "#", "" }}
bright2={{ colors.source_color.default.hex | set_hue: 120.0 | replace: "#", "" }}
bright3={{ colors.source_color.default.hex | set_hue: 50.0 | replace: "#", "" }}
bright4={{ colors.source_color.default.hex | replace: "#", "" }}
bright5={{ colors.source_color.default.hex | set_hue: 300.0 | replace: "#", "" }}
bright6={{ colors.source_color.default.hex | set_hue: 190.0 | replace: "#", "" }}
bright7={{ colors.on_surface.default.hex | replace: "#", "" }}
selection-foreground={{ colors.on_primary.default.hex | replace: "#", "" }}
selection-background={{ colors.primary.default.hex | replace: "#", "" }}
<* endif *>
