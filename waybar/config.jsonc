{
  "expand-center": false,
  "height": 25,
  "position": "top",
  "modules-left": [
    "sway/workspaces",
    "sway/mode",
    "sway/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "cpu",
    "temperature",
    "memory",
    "power-profiles-daemon",
    "battery",
    "temperature#ambient",
    "backlight",
    "wireplumber"
  ],
  "sway/workspaces": {
    "disable-scroll-wraparound": true,
    "format": " {name} "
  },
  "sway/window": {
    "expand": true,
    "icon": true,
    "icon-size": 14
  },
  "cpu": {
    "interval": 2,
    "format": "󰇺  {avg_frequency} GHz"
  },
  "temperature": {
    "interval": 2,
    "thermal-zone": 8,
    "tooltip": false,
    "format": "󰏈  {temperatureC} °C"
  },
  "temperature#ambient": {
    "interval": 5,
    "thermal-zone": 0,
    "tooltip": false,
    "format": "󰔏 {temperatureC} °C"
  },
  "memory": {
    "interval": 2,
    "format": "󰏇  {used} GiB",
    "tooltip-format": "Swap: {swapUsed}GiB"
  },
  "network#speed": {
    "interval": 1,
    "format": "  {bandwidthUpBytes}   {bandwidthDownBytes}",
    "tooltip-format": "IP: {ipaddr}"
  },
  "battery": {
    "format": "  {capacity} %"
  },
  "power-profiles-daemon": {
    "format": "󱀚  {icon}",
    "format-icons": {
      "performance": "󰢾",
      "balanced": "󰢽",
      "power-saver": "󰢼"
    }
  },
  "backlight": {
    "format": "󰱊  {percent} %",
    "tooltip": false
  },
  "wireplumber": {
    "format": "  {volume} %"
  },
  "clock": {
    "interval": 60,
    "format": "{:%a, %d %b %Y - %H:%M}",
    "tooltip": false
  }
}
