{
  "expand-center": true,
  "height": 40,
  "position": "bottom",
  "modules-left": [
    "ext/workspaces",
    "wlr/taskbar"
  ],
  "modules-center": [
  ],
  "modules-right": [
    "cpu",
    "temperature",
    "memory",
    "power-profiles-daemon",
    "battery",
    "tray",
    "clock"
  ],
  "ext/workspaces": {
    "format": "{name}",
    "sort-by-id": true,
    "on-click": "activate"
  },
  "wlr/taskbar": {
    "format": "{icon} {app_id}",
    "max-length": 18,
    "icon-size": 16,
    "on-click": "minimize-raise",
    "on-click-middle": "close",
    "on-click-right": "fullscreen",
    "tooltip-format": "{title}"
  },
  "cpu": {
    "interval": 2,
    "format": "󰇺  {avg_frequency} GHz"
  },
  "temperature": {
    "interval": 2,
    "thermal-zone": 8,
    "tooltip": false,
    "format": "󰏈  {temperatureC} °C"
  },
  "temperature#ambient": {
    "interval": 5,
    "thermal-zone": 0,
    "tooltip": false,
    "format": "󰔏 {temperatureC} °C"
  },
  "memory": {
    "interval": 2,
    "format": "󰏇  {used} GiB",
    "tooltip-format": "Swap: {swapUsed}GiB"
  },
  "network#speed": {
    "interval": 1,
    "format": "  {bandwidthUpBytes}   {bandwidthDownBytes}",
    "tooltip-format": "IP: {ipaddr}"
  },
  "battery": {
    "format": "  {capacity}"
  },
  "power-profiles-daemon": {
    "format": "󱀚  {icon}",
    "format-icons": {
      "performance": "󰢾",
      "balanced": "󰢽",
      "power-saver": "󰢼"
    }
  },
  "backlight": {
    "format": "󰱊  {percent} %",
    "tooltip": false
  },
  "wireplumber": {
    "format": "  {volume} %"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "clock": {
    "interval": 60,
    "format": "{:%a, %d %b %Y - %H:%M}",
    "tooltip": false
  }
}
