# ~/.config/mako/config
# Breeze Light (KDE palette)

font=Iosevka NF 10
background-color=#eff0f1f2
text-color=#232629ff
border-color=#3daee9ff
border-size=2
border-radius=4
progress-color=over #3daee9ff

padding=8
margin=8
width=360
height=120
max-visible=5
anchor=top-right
default-timeout=5000
icons=1
max-icon-size=48
markup=1

[urgency=low]
border-color=#707d8aff

[urgency=normal]
border-color=#3daee9ff

[urgency=critical]
border-color=#da4453ff
default-timeout=0
