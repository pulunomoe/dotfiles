<?xml version="1.0"?>

<labwc_config>

  <theme>
    <name>labwc</name>
    <cornerRadius>8</cornerRadius>
    <dropShadows>yes</dropShadows>
    <icon>Papirus-Light</icon>
    <font name="Iosevka NF" size="14" />
  </theme>
  
  <desktops number="4">
  	<prefix>></prefix>
  </desktops>

  <snapping>
    <range inner="10" outer="10" />
    <topMaximize>yes</topMaximize>
    <notifyClient>always</notifyClient>
  </snapping>
  
  <windowSwitcher allWorkspaces="yes">
  	<fields>
  		<field content="workspace" width="15%" />
  		<field content="icon" width="10%" />
    	<field content="desktop_entry_name" width="75%" />
  	</fields>
  </windowSwitcher>

  <keyboard>
    <default />
    <keybind key="W-Return">
      <action name="Execute" command="foot" />
    </keybind>
    <keybind key="W-d">
      <action name="Execute" command="fuzzel" />
    </keybind>
    <keybind key="W-e">
      <action name="Execute" command="thunar" />
    </keybind>
    <keybind key="W-l">
      <action name="Execute" command="swaylock" />
    </keybind>
    <keybind key="W-q">
      <action name="Close" />
    </keybind>
    <!-- Windows/KDE-style manual tiling -->
    <keybind key="W-Left">
      <action name="SnapToEdge" direction="left" combine="yes" />
    </keybind>
    <keybind key="W-Right">
      <action name="SnapToEdge" direction="right" combine="yes" />
    </keybind>
    <keybind key="W-Up">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="W-Down">
      <action name="SnapToEdge" direction="down" combine="yes" />
    </keybind>
    <keybind key="W-S-Left">
      <action name="MoveToEdge" direction="left" snapWindows="yes" />
    </keybind>
    <keybind key="W-S-Right">
      <action name="MoveToEdge" direction="right" snapWindows="yes" />
    </keybind>
    <keybind key="W-S-Up">
      <action name="MoveToEdge" direction="up" snapWindows="yes" />
    </keybind>
    <keybind key="W-S-Down">
      <action name="MoveToEdge" direction="down" snapWindows="yes" />
    </keybind>
    <keybind key="W-c">
      <action name="SnapToEdge" direction="center" />
    </keybind>
    <keybind key="W-m">
      <action name="Iconify" />
    </keybind>
    <keybind key="W-f">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="W-S-f">
      <action name="ToggleFullscreen" />
    </keybind>
    <keybind key="A-Space">
      <action name="ShowMenu" menu="client-menu" atCursor="no" />
    </keybind>
    <keybind key="W-S-r">
      <action name="Reconfigure" />
    </keybind>
    <keybind key="W-1">
      <action name="GoToDesktop" to="1" />
    </keybind>
    <keybind key="W-2">
      <action name="GoToDesktop" to="2" />
    </keybind>
    <keybind key="W-3">
      <action name="GoToDesktop" to="3" />
    </keybind>
    <keybind key="W-4">
      <action name="GoToDesktop" to="4" />
    </keybind>
    <keybind key="W-S-1">
      <action name="SendToDesktop" to="1" />
    </keybind>
    <keybind key="W-S-2">
      <action name="SendToDesktop" to="2" />
    </keybind>
    <keybind key="W-S-3">
      <action name="SendToDesktop" to="3" />
    </keybind>
    <keybind key="W-S-4">
      <action name="SendToDesktop" to="4" />
    </keybind>
    <keybind key="Print">
    	<action name="Execute">
		  	<command>
		  		sh -c 'grim -g "$(slurp)" /home/pulu/Pictures/screenshot-$(date +%Y-%m-%d_%H-%M-%S).png'
		  	</command>
    	</action>
    </keybind>
  </keyboard>

  <mouse>
    <default />
    <context name="Root">
      <mousebind button="Left" action="Press">
        <action name="None" />
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="root-menu" />
      </mousebind>
    </context>
  </mouse>

</labwc_config>

